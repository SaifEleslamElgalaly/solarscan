flowchart TB

  %% ==================== CLIENT ====================
  subgraph CLIENT["Client (Flutter)&nbsp;&nbsp;&nbsp;&nbsp;"]
    CAM["Camera Capture<br/><i>camera_screen.dart</i>"]
    PROV["ScanNotifier<br/><i>scan_provider.dart</i>"]
    RES["Result Screen<br/>class · confidence% · recommendation<br/>(no box overlay)"]
    CAM --> PROV
  end

  %% ==================== BACKEND ====================
  subgraph BACKEND["Backend (PHP)&nbsp;&nbsp;&nbsp;&nbsp;"]
    API["service_api.php<br/>upload_scan · get_history · retrain<br/>register · login"]
    UP["uploads/<br/>(saved image)"]
    API --> UP
  end

  %% ==================== AI SERVICE ====================
  subgraph AI["AI Service&nbsp;&nbsp;&nbsp;&nbsp;"]
    PRED["POST /predict · 127.0.0.1:8000<br/>YOLOv8 classification (yolov8n-cls)<br/>6 classes, top-1<br/>conf &lt; 0.5 → Unknown"]
    RETR["POST /retrain · :8000"]
  end

  %% ==================== DATABASE ====================
  subgraph DB["Database (MySQL)&nbsp;&nbsp;&nbsp;&nbsp;"]
    SCANS[("scans")]
    USERS[("users")]
    OTHER[("panels · roles<br/>permissions · settings")]
  end

  %% ==================== DASHBOARD ====================
  subgraph DASH["Admin Dashboard (PHP)&nbsp;&nbsp;&nbsp;&nbsp;"]
    IDX["index.php (stats)<br/>users · panels · roles · permissions<br/>reports · alerts · settings"]
  end

  %% ---------- Scan flow ----------
  PROV -- "image + user_id&nbsp;" --> API
  API -- "cURL: file&nbsp;" --> PRED
  PRED -- "JSON: class, confidence, recommendation&nbsp;" --> API
  API -- "INSERT scans&nbsp;" --> SCANS
  API -- "JSON result&nbsp;" --> RES

  %% ---------- History ----------
  PROV -- "?action=get_history&nbsp;" --> API
  API -- "SELECT scans&nbsp;" --> SCANS

  %% ---------- Dashboard reads ----------
  IDX -- "SELECT / COUNT&nbsp;" --> SCANS
  IDX -. "SELECT&nbsp;" .-> USERS
  IDX -. "SELECT&nbsp;" .-> OTHER

  %% ---------- Retrain ----------
  IDX -- "?action=retrain&nbsp;" --> API
  API -- "cURL: /retrain&nbsp;" --> RETR
  RETR -- "JSON: message&nbsp;" --> API

