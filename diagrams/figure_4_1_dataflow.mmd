  classDef db      fill:#F3E5F5,stroke:#6A1B9A,stroke-width:1px,color:#2E0B3F;
  classDef dash    fill:#ECEFF1,stroke:#37474F,stroke-width:1px,color:#1A2227;

  class CAM,PROV,RES client;
  class API,UP backend;
